
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Petshop_SAEP</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Petshop_SAEP.styles.css"
          asp-append-version="true" />

</head>

<body class="app-body">

    <header class="site-header">

        <nav class="navbar navbar-expand-lg navbar-dark">

            <div class="container-fluid px-3">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Pet"
                   asp-action="Index">

                    <span class="brand-icon">✳</span>

                    <span class="brand-name">
                        Petshop_<span>SAEP</span>
                    </span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Alternar navegação">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    <ul class="navbar-nav me-auto nav-links">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Tutor"
                               asp-action="Index">

                                Tutor

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Pet"
                               asp-action="Index">

                                Pet

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Agendamentos"
                               asp-action="Index">

                                Agendamento

                            </a>
                        </li>

                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="nav-user">

                            <span class="nav-user-name">
                                Olá, @User.Identity.Name
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="nav-logout">

                                    Sair

                                </button>

                            </form>

                        </div>
                    }

                </div>

            </div>

        </nav>

    </header>

    <div class="container">

        <main role="main" class="app-main pb-3">

            @RenderBody()

        </main>

    </div>

    <footer class="site-footer">

        <div class="container">

            &copy; @DateTime.Now.Year - Petshop_SAEP

            <span> · </span>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
